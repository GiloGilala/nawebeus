# Database
# DATABASE_URL is the single source of truth — the app, seed, tests, AND
# `bun run db:push` all read it. The DB_* variables are an optional fallback
# for when DATABASE_URL is unset; if both are set and any of them disagrees
# with the URL, db:push refuses to run (NWB-P0-009). See docs/agents/local-database.md.
DATABASE_URL=postgresql://user:password@localhost:5432/nawebeus

# JWT secrets (minimum 32 characters each)
JWT_ACCESS_SECRET=your-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars-long

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Seed credentials (defaults: admin@nawebeus.com / Admin@123456)
SEED_ADMIN_EMAIL=admin@nawebeus.com
SEED_ADMIN_PASSWORD=Admin@123456
