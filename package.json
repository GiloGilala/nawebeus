{
  "name": "nawebeus",
  "version": "0.1.0",
  "private": true,
  "description": "Unified social media management and PR intelligence SaaS for the Nigerian and African market",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:start": "echo 'TanStack Start: run `bunx --bun vinxi dev` (requires vinxi)'",
    "dev:hono": "bun run --hot src/index.ts",
    "build": "tsc --noEmit && bun build src/index.ts --outdir dist --target bun",
    "build:start": "echo 'TanStack Start build: vinxi build'",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "coverage": "bun test --coverage --coverage-reporter=lcov",
    "coverage:check": "bun src/scripts/check-coverage.ts",
    "db:reclaim-rate-limits": "bun src/scripts/reclaim-rate-limits.ts",
    "queue:worker": "bun src/scripts/queue-worker.ts",
    "queue:run": "bun src/scripts/queue-run.ts",
    "email:smoke": "bun src/scripts/email-smoke.ts",
    "migrate": "drizzle-kit push",
    "seed": "bun run src/seed.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.12.32",
    "pg": "^8.13.0",
    "pg-boss": "^12.33.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
