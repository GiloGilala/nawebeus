{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@db/*": ["./db/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "docs",
    "db/billing/**",
    "db/campaigns/**",
    "db/commerce/**",
    // db/compliance/** is wired since NWB-P1-010 (legal_holds + backup_records adopted;
    // the other four models compile but stay dormant until their own tickets).
    "db/engagement/**",
    "db/influencer/**",
    "db/monitoring/**",
    "db/pr/**",
    "db/publishing/**",
    // db/social-accounts/** is wired since NWB-P2-001 (the four tables adopted; OAuth flow
    // consumes them).
    "db/relations.ts"
  ]
}
