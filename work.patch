+  addPaymentMethod,
+  cancelSubscription,
+  createSubscription,
+  deletePaymentMethod as deletePaymentMethodService,
+  getEntitlements,
+  getInvoice,
+  getPlan,
+  getSubscription,
+  listInvoices,
+  listPaymentMethods,
+  listPlans,
+  listSubscriptions,
+  listTransactions,
+  payInvoice,
+  resumeSubscription,
+  updatePaymentMethod,
